  </Item>
  <Item class="ServerScriptService" referent="RBX_ee9497e24d6cb01e">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX_c7ada634b0186f74">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX_6cb15f39ad415c87">
        <Properties>
          <string name="Name">DataService</string>
          <ProtectedString name="Source">--[[
	DataService.luau
	Server-authoritative DataStore persistence manager for player stats and settings.
--]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}
local playerData = {}
local dataStore = nil

-- Attempt safely getting DataStore (handles Studio disabled datastore)
pcall(function()
	dataStore = DataStoreService:GetDataStore("DontWakeHim_PlayerData_v1")
end)

function DataService.Init()
	Players.PlayerAdded:Connect(function(player)
		DataService.LoadData(player)
	end)
	
	Players.PlayerRemoving:Connect(function(player)
		DataService.SaveData(player)
		playerData[player.UserId] = nil
	end)
end

function DataService.LoadData(player: Player)
	local userId = player.UserId
	local defaultData = {
		Coins = Config.DataDefaults.Coins,
		Escapes = Config.DataDefaults.Escapes,
		Deaths = Config.DataDefaults.Deaths,
		BestTime = Config.DataDefaults.BestTime,
		Cosmetics = Config.DataDefaults.Cosmetics,
		Settings = Config.DataDefaults.Settings,
	}
	
	if not dataStore then
		playerData[userId] = defaultData
		return defaultData
	end
	
	local key = "Player_" .. userId
	local success, result = pcall(function()
		return dataStore:GetAsync(key)
	end)
	
	if success and result and type(result) == "table" then
		-- Merge saved data with defaults for version safety
		for k, v in pairs(defaultData) do
			if result[k] == nil then
				result[k] = v
			end
		end
		playerData[userId] = result
	else
		playerData[userId] = defaultData
	end
	
	return playerData[userId]
end

function DataService.GetData(player: Player)
	if not playerData[player.UserId] then
		return DataService.LoadData(player)
	end
	return playerData[player.UserId]
end

function DataService.SaveData(player: Player)
	local userId = player.UserId
	local data = playerData[userId]
	if not data or not dataStore then
		return false
	end
	
	local key = "Player_" .. userId
	local attempts = 0
	local success = false
	
	while attempts &lt; 3 and not success do
		attempts = attempts + 1
		success = pcall(function()
			dataStore:SetAsync(key, data)
		end)
		if not success then
			task.wait(1)
		end
	end
	
	return success
end

function DataService.AddCoins(player: Player, amount: number)
	local data = DataService.GetData(player)
	if data and amount &gt; 0 then
		data.Coins = data.Coins + math.floor(amount)
	end
end

function DataService.IncrementEscapes(player: Player, timeTaken: number)
	local data = DataService.GetData(player)
	if data then
		data.Escapes = data.Escapes + 1
		if not data.BestTime or timeTaken &lt; data.BestTime then
			data.BestTime = math.floor(timeTaken)
		end
	end
end

function DataService.IncrementDeaths(player: Player)
	local data = DataService.GetData(player)
	if data then
		data.Deaths = data.Deaths + 1
	end
end

return DataService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_2ad10ee99f4421b2">
        <Properties>
          <string name="Name">AnalyticsService</string>
          <ProtectedString name="Source">--[[
	AnalyticsService.luau
	Telemetry and event tracking foundation.
--]]

local AnalyticsService = {}
local eventLog = {}

function AnalyticsService.TrackEvent(eventName: string, data: table?)
	local record = {
		Event = eventName,
		Timestamp = os.time(),
		Data = data or {},
	}
	table.insert(eventLog, record)
	print("[ANALYTICS]", eventName, data and game:GetService("HttpService"):JSONEncode(data) or "")
end

function AnalyticsService.GetLogs()
	return eventLog
end

return AnalyticsService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_c50b86e632592634">
        <Properties>
          <string name="Name">RewardService</string>
          <ProtectedString name="Source">--[[
	RewardService.luau
	Calculates and distributes server-authoritative round rewards.
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local RewardService = {}

function RewardService.CalculateRewards(player: Player, escaped: boolean, timeRemaining: number, isCleanRound: boolean)
	local totalCoins = 0
	local breakdown = {
		EscapeReward = 0,
		TimeBonus = 0,
		CleanBonus = 0,
		ParticipationReward = 0,
	}
	
	if escaped then
		breakdown.EscapeReward = Config.Rewards.EscapeCoins
		breakdown.TimeBonus = math.floor(timeRemaining * Config.Rewards.TimeBonusCoinsPerSec)
		if isCleanRound then
			breakdown.CleanBonus = Config.Rewards.CleanBonusCoins
		end
		totalCoins = breakdown.EscapeReward + breakdown.TimeBonus + breakdown.CleanBonus
	else
		breakdown.ParticipationReward = Config.Rewards.ParticipationCoins
		totalCoins = breakdown.ParticipationReward
	end
	
	return totalCoins, breakdown
end

return RewardService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_076547be1e9aaa49">
        <Properties>
          <string name="Name">MonetizationService</string>
          <ProtectedString name="Source">--[[
	MonetizationService.luau
	Cosmetics and shop catalog manager.
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)

local MonetizationService = {}
local shopRemote = nil
local dataServiceRef = nil
local analyticsRef = nil

-- Server-side ShopEvent handler (CLIENT -&gt; SERVER: OpenShop / Buy;
-- SERVER -&gt; CLIENT: ShopData / PurchaseResult). All purchases are validated
-- here against DataStore-backed coins — no client-side currency, no Robux.
function MonetizationService.Init(remotesFolder: Folder, dataService, analyticsService)
	dataServiceRef = dataService
	analyticsRef = analyticsService
	shopRemote = remotesFolder:FindFirstChild(Constants.RemoteNames.ShopEvent)
	if not shopRemote then
		warn("[SHOP] ShopEvent remote not found!")
		return
	end

	shopRemote.OnServerEvent:Connect(function(player: Player, data: table)
		if type(data) ~= "table" then return end
		local action = data.Action

		if action == "OpenShop" then
			if analyticsRef then
				analyticsRef.TrackEvent(Constants.AnalyticsEvents.ShopOpened, { Player = player.Name })
			end
			shopRemote:FireClient(player, {
				Action = "ShopData",
				Coins = MonetizationService.GetCoins(player),
				Owned = dataServiceRef and dataServiceRef.GetData(player) and dataServiceRef.GetData(player).Cosmetics or {},
			})

		elseif action == "Buy" then
			local category = data.Category
			local itemId = data.Id
			if type(category) ~= "string" or type(itemId) ~= "string" then return end

			local success, message, newCoins = MonetizationService.PurchaseCosmetic(player, category, itemId, dataServiceRef)
			if success and analyticsRef then
				analyticsRef.TrackEvent(Constants.AnalyticsEvents.CosmeticPurchased, {
					Player = player.Name,
					Category = category,
					Id = itemId,
				})
			end
			shopRemote:FireClient(player, {
				Action = "PurchaseResult",
				Success = success,
				Message = message,
				Coins = newCoins or MonetizationService.GetCoins(player),
				Owned = dataServiceRef and dataServiceRef.GetData(player) and dataServiceRef.GetData(player).Cosmetics or {},
			})
		end
	end)

	print("[SHOP] MonetizationService initialized (cosmetic-only, server-validated).")
end

function MonetizationService.GetCoins(player: Player): number
	if not dataServiceRef then return 0 end
	local data = dataServiceRef.GetData(player)
	return data and data.Coins or 0
end

function MonetizationService.GetCatalog()
	return Config.ShopCatalog
end

function MonetizationService.PurchaseCosmetic(player: Player, itemCategory: string, itemId: string, dataService)
	local data = dataService.GetData(player)
	if not data then return false, "No Data" end
	
	local catalogCategory = Config.ShopCatalog[itemCategory]
	if not catalogCategory then return false, "Invalid Category" end
	
	local targetItem = nil
	for _, item in ipairs(catalogCategory) do
		if item.Id == itemId then
			targetItem = item
			break
		end
	end
	
	if not targetItem then return false, "Item Not Found" end
	
	if data.Coins &lt; targetItem.Price then
		return false, "Insufficient Coins"
	end
	
	-- Deduct coins and record ownership
	data.Coins = data.Coins - targetItem.Price
	data.Cosmetics[itemCategory] = targetItem.Id
	
	return true, "Success", data.Coins
end

return MonetizationService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_1ccfd4a025e3a860">
        <Properties>
          <string name="Name">NoiseService</string>
          <ProtectedString name="Source">--[[
	NoiseService.luau
	Server-authoritative noise management system for DON'T WAKE HIM.
	The server decides every noise value: client requests are rate-limited,
	validated, and amounts come from Config — never from raw client data.
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)
local Utility = require(ReplicatedStorage.Shared.Utility)

local NoiseService = {}
local currentNoise = 0
local lastNoiseTimestamp = 0
local noiseEventRemote = nil
local rateLimiter = Utility.CreateRateLimiter(Config.Security.RateLimitEventsPerSec)
local roundServiceRef = nil

function NoiseService.SetRoundService(roundService)
	roundServiceRef = roundService
end

local function roundIsActive(): boolean
	if not roundServiceRef then return true end
	return roundServiceRef.GetState() == Constants.RoundState.ACTIVE
end

function NoiseService.Init(remotesFolder: Folder)
	noiseEventRemote = remotesFolder:FindFirstChild(Constants.RemoteNames.NoiseEvent)

	-- Listen for movement and action noise events from clients
	if noiseEventRemote then
		noiseEventRemote.OnServerEvent:Connect(function(player: Player, data: table)
			if type(data) ~= "table" then return end
			if not rateLimiter(player) then return end -- reject remote spam
			if not roundIsActive() then return end    -- no lobby noise feeding the monster

			-- Server only accepts noise from living, present characters
			local char = player.Character
			if not char or not Utility.IsPlayerAlive(player) then return end
			local pos = (char.PrimaryPart or char:GetPivot()).Position

			local action = data.Action
			if action == "MovementNoise" then
				-- Amount is chosen entirely by the server from Config.
				local isSprinting = data.IsSprinting == true
				local amount = isSprinting and Config.Noise.Contributions.Sprint or Config.Noise.Contributions.Walk
				NoiseService.AddNoise(amount, pos)
			elseif action == "ActionNoise" then
				-- Malformed/excessive client amounts are clamped to the
				-- loudest possible configured contribution.
				local amount = tonumber(data.Amount) or 0
				amount = math.clamp(amount, 0, Config.Noise.Contributions.LoudEvent)
				if amount &gt; 0 then
					NoiseService.AddNoise(amount, pos)
				end
			end
		end)
	end

	-- Noise Decay Loop
	RunService.Heartbeat:Connect(function(deltaTime)
		if currentNoise &gt; 0 and (os.clock() - lastNoiseTimestamp) &gt; Config.Noise.DecayDelayAfterNoise then
			local decayAmount = Config.Noise.DecayRatePerSecond * deltaTime
			NoiseService.SetNoise(math.max(0, currentNoise - decayAmount))
		end
	end)
end

function NoiseService.GetNoise(): number
	return currentNoise
end

function NoiseService.GetLevel(): string
	if currentNoise &gt;= Config.Noise.Thresholds.WakeMin then
		return Constants.NoiseLevel.WAKE
	elseif currentNoise &gt;= Config.Noise.Thresholds.DangerMax then
		return Constants.NoiseLevel.DANGER
	elseif currentNoise &gt;= Config.Noise.Thresholds.AlertMax then
		return Constants.NoiseLevel.ALERT
	else
		return Constants.NoiseLevel.SAFE
	end
end

function NoiseService.SetNoise(amount: number)
	local clamped = math.clamp(amount, 0, Config.Noise.MaxNoise)
	if math.abs(clamped - currentNoise) &gt; 0.01 then
		currentNoise = clamped
		NoiseService.Broadcast()
	end
end

function NoiseService.AddNoise(amount: number, sourcePosition: Vector3?)
	if amount &lt;= 0 then return end
	lastNoiseTimestamp = os.clock()
	NoiseService.SetNoise(currentNoise + amount)

	if noiseEventRemote then
		noiseEventRemote:FireAllClients({
			Action = "NoiseBurst",
			Amount = amount,
			TotalNoise = currentNoise,
			Level = NoiseService.GetLevel(),
			Position = sourcePosition,
		})
	end

	-- Notify MonsterService if monster is active
	local MonsterService = NoiseService.MonsterService
	if MonsterService then
		MonsterService.OnNoiseEmitted(currentNoise, sourcePosition)
	end
end

function NoiseService.ResetNoise()
	currentNoise = 0
	lastNoiseTimestamp = 0
	NoiseService.Broadcast()
end

function NoiseService.Broadcast()
	if noiseEventRemote then
		noiseEventRemote:FireAllClients({
			Action = "UpdateNoise",
			TotalNoise = currentNoise,
			Level = NoiseService.GetLevel(),
		})
	end
end

return NoiseService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_a9d75acf36ccf9fb">
        <Properties>
          <string name="Name">InteractionService</string>
          <ProtectedString name="Source">--[[
	InteractionService.luau
	Server-authoritative interaction handler for doors, hiding spots, clues,
	and the UIEvent endpoints (stats / settings).
	Architecture: all physical interactions use server-wired ProximityPrompts
	(the old duplicate client InteractionEvent path was removed).
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)
local Utility = require(ReplicatedStorage.Shared.Utility)

local InteractionService = {}
local rateLimiter = Utility.CreateRateLimiter(Config.Security.RateLimitEventsPerSec)
local playerHidingState = {} -- userId -&gt; hiding spot (Part or Model)
local uiRemote = nil
local roundServiceRef = nil
local dataServiceRef = nil
local noiseServiceRef = nil
local objectiveServiceRef = nil
local doorHomeCF = {} -- doorModel -&gt; original closed CFrame of its Hinge

function InteractionService.Init(remotesFolder: Folder, noiseService, objectiveService, roundService, dataService)
	uiRemote = remotesFolder:FindFirstChild(Constants.RemoteNames.UIEvent)
	roundServiceRef = roundService
	dataServiceRef = dataService
	noiseServiceRef = noiseService
	objectiveServiceRef = objectiveService

	-- UIEvent: client -&gt; server requests (stats &amp; settings)
	if uiRemote then
		uiRemote.OnServerEvent:Connect(function(player: Player, data: table)
			if type(data) ~= "table" then return end
			if not rateLimiter(player) then return end

			local action = data.Action
			if action == "GetStats" then
				local stats = dataServiceRef and dataServiceRef.GetData(player)
				uiRemote:FireClient(player, {
					Action = "Stats",
					Coins = stats and stats.Coins or 0,
					Escapes = stats and stats.Escapes or 0,
					Deaths = stats and stats.Deaths or 0,
					BestTime = stats and stats.BestTime,
				})
			elseif action == "GetSettings" then
				local stats = dataServiceRef and dataServiceRef.GetData(player)
				local s = (stats and stats.Settings) or Config.DataDefaults.Settings
				uiRemote:FireClient(player, {
					Action = "Settings",
					Settings = {
						MusicVolume = s.MusicVolume,
						SFXVolume = s.SFXVolume,
						ReducedEffects = s.ReducedEffects,
					},
				})
			elseif action == "SaveSettings" then
				-- Never trust client values: clamp and coerce everything.
				local incoming = data.Settings
				if type(incoming) == "table" and dataServiceRef then
					local d = dataServiceRef.GetData(player)
					if d then
						local function clampUnit(v, default)
							v = tonumber(v)
							if not v then return default end
							return math.clamp(v, 0, 1)
						end
						d.Settings = d.Settings or {}
						d.Settings.MusicVolume = clampUnit(incoming.MusicVolume, Config.DataDefaults.Settings.MusicVolume)
						d.Settings.SFXVolume = clampUnit(incoming.SFXVolume, Config.DataDefaults.Settings.SFXVolume)
						d.Settings.ReducedEffects = incoming.ReducedEffects == true
					end
				end
			end
		end)
	end

	-- Wire workspace ProximityPrompts for direct server handling
	InteractionService.WireWorkspacePrompts(noiseService, objectiveService, roundService)
end

local function canInteract(player: Player): boolean
	if not Utility.IsPlayerAlive(player) then return false end
	if roundServiceRef and roundServiceRef.GetState() ~= Constants.RoundState.ACTIVE then return false end
	return true
end

function InteractionService.WireWorkspacePrompts(noiseService, objectiveService, roundService)
	-- Bind doors (ProximityPrompt lives inside the Hinge part of each door Model)
	local interactables = workspace:FindFirstChild("Interactables")
	if interactables then
		for _, child in ipairs(interactables:GetChildren()) do
			local prompt = child:FindFirstChildOfClass("ProximityPrompt") or child:FindFirstChild("ProximityPrompt", true)
			if prompt then
				prompt.Triggered:Connect(function(player)
					if canInteract(player) then
						InteractionService.HandleDoor(player, child, noiseService)
					end
				end)
			end
		end
	end

	-- Bind hiding spots (prompt may be nested inside wardrobe panels)
	local hidingFolder = workspace:FindFirstChild("HidingSpots")
	if hidingFolder then
		for _, spot in ipairs(hidingFolder:GetChildren()) do
			local prompt = spot:FindFirstChildOfClass("ProximityPrompt") or spot:FindFirstChild("ProximityPrompt", true)
			if prompt then
				prompt.Triggered:Connect(function(player)
					if canInteract(player) then
						InteractionService.HandleHidingSpot(player, spot, roundService)
					end
				end)
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- Doors: server-validated toggle with smooth tween + door audio for everyone
-- ---------------------------------------------------------------------------
function InteractionService.HandleDoor(player: Player, doorInstance: Instance, noiseService)
	local doorModel = doorInstance:IsA("Model") and doorInstance or doorInstance.Parent
	if not doorModel then return end

	local isOpen = doorModel:GetAttribute("IsOpen") == true
	isOpen = not isOpen
	doorModel:SetAttribute("IsOpen", isOpen)

	local doorPos = doorInstance:IsA("Model") and doorModel:GetPivot().Position or doorInstance.Position

	local hinge = doorModel:FindFirstChild("Hinge") or doorModel.PrimaryPart or doorModel:FindFirstChildOfClass("BasePart")
	if hinge and hinge:IsA("BasePart") then
		-- Remember the factory-closed pose the first time we see this door.
		if doorHomeCF[doorModel] == nil then
			doorHomeCF[doorModel] = hinge.CFrame
		end
		local closedCF = doorHomeCF[doorModel]
		local targetCF = isOpen and (closedCF * CFrame.Angles(0, math.rad(-90), 0)) or closedCF

		TweenService:Create(hinge, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = targetCF,
		}):Play()
	end

	-- Door audio for every player (positional, cleaned up automatically)
	if uiRemote then
		uiRemote:FireAllClients({
			Action = "PlaySoundAt",
			Sound = "DoorOpen",
			Target = hinge,
			Volume = 0.8,
			Pitch = isOpen and 1.0 or 0.85,
		})
	end

	-- Emit noise burst for door interaction
	local svc = noiseService or noiseServiceRef
	if svc then
		svc.AddNoise(Config.Noise.Contributions.OpenDoor, doorPos)
	end
end

function InteractionService.ResetDoors()
	for doorModel, homeCF in pairs(doorHomeCF) do
		if doorModel.Parent then
			doorModel:SetAttribute("IsOpen", false)
			local hinge = doorModel:FindFirstChild("Hinge")
			if hinge and hinge:IsA("BasePart") then
				hinge.CFrame = homeCF
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- Hiding spots
-- ---------------------------------------------------------------------------
local function spotPivot(spot: Instance): CFrame
	if spot:IsA("Model") then
		return spot:GetPivot()
	end
	return spot.CFrame
end

function InteractionService.HandleHidingSpot(player: Player, hidingSpot: Instance, roundService)
	local rs = roundService or roundServiceRef
	local userId = player.UserId
	local currentSpot = playerHidingState[userId]

	if currentSpot then
		-- Exit hiding spot
		playerHidingState[userId] = nil
		if rs and rs.GetPlayerState(player) == Constants.PlayerState.HIDING then
			rs.SetPlayerState(player, Constants.PlayerState.PLAYING)
		end
		local char = player.Character
		if char then
			local exitMarker = currentSpot:FindFirstChild("ExitMarker")
			if exitMarker then
				-- Drop-in exit: pivot 3 studs above the marker so the player
				-- lands cleanly on the floor instead of inside it.
				char:PivotTo(exitMarker.CFrame * CFrame.new(0, 3, 0))
			else
				char:PivotTo(spotPivot(currentSpot) * CFrame.new(0, 0, 4))
			end
		end
	else
		-- Enter hiding spot: only living players actively in the round
		if not hidingSpot then return end
		if rs and rs.GetPlayerState(player) ~= Constants.PlayerState.PLAYING then return end

		playerHidingState[userId] = hidingSpot
		if rs then
			rs.SetPlayerState(player, Constants.PlayerState.HIDING)
		end
		local char = player.Character
		if char then
			char:PivotTo(spotPivot(hidingSpot))
		end
	end
end

-- ---------------------------------------------------------------------------
-- Clues
-- ---------------------------------------------------------------------------
function InteractionService.HandleReadClue(player: Player, clueInstance: Instance)
	if not canInteract(player) then return end

	local text = clueInstance:GetAttribute("ClueText") or "Keep quiet! The monster hears every step."
	local title = clueInstance:GetAttribute("ClueTitle") or "Scrawled Note"

	if uiRemote then
		uiRemote:FireClient(player, {
			Action = "ShowClue",
			Title = title,
			Text = text,
		})
	end
end

function InteractionService.IsPlayerHiding(player: Player): boolean
	return playerHidingState[player.UserId] ~= nil
end

function InteractionService.ClearHidingState(player: Player)
	playerHidingState[player.UserId] = nil
end

function InteractionService.ResetHidingStates()
	playerHidingState = {}
end

return InteractionService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_9ca0895ac71bbed4">
        <Properties>
          <string name="Name">ObjectiveService</string>
          <ProtectedString name="Source">--[[
	ObjectiveService.luau
	Server-authoritative objective spawn, key collection, clues, and exit unlock engine.
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)
local Utility = require(ReplicatedStorage.Shared.Utility)

local ObjectiveService = {}
local activeObjectives = {} -- Map of Model/Part -&gt; ObjectiveId
local collectedCount = 0
local objectiveRemote = nil
local uiRemote = nil
local exitUnlocked = false
local analyticsRef = nil

function ObjectiveService.Init(remotesFolder: Folder, roundService, analyticsService)
	objectiveRemote = remotesFolder:FindFirstChild(Constants.RemoteNames.ObjectiveEvent)
	uiRemote = remotesFolder:FindFirstChild(Constants.RemoteNames.UIEvent)
	ObjectiveService.RoundService = roundService
	analyticsRef = analyticsService

	-- Wire Exit Door ProximityPrompt (server validated: alive + round active)
	local exitDoor = workspace:FindFirstChild("Exit") and workspace.Exit:FindFirstChild("ExitDoor")
	if exitDoor then
		local prompt = exitDoor:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt.Triggered:Connect(function(player)
				if not Utility.IsPlayerAlive(player) then return end
				if roundService and roundService.GetState() ~= Constants.RoundState.ACTIVE then return end
				ObjectiveService.TryEscape(player)
			end)
		end
	end
end

function ObjectiveService.SetupRoundObjectives(keySpawnsFolder: Instance, interactablesFolder: Instance)
	activeObjectives = {}
	collectedCount = 0
	exitUnlocked = false
	
	-- Clear existing keys
	for _, child in ipairs(interactablesFolder:GetChildren()) do
		if child.Name:sub(1, 13) == "ObjectiveKey_" then
			child:Destroy()
		end
	end
	
	-- Resolve spawn folder robustly (exact match first, then recursive fallback)
	if not keySpawnsFolder or #keySpawnsFolder:GetChildren() &lt; Config.Objectives.TotalRequired then
		local fallback = workspace:FindFirstChild("KeySpawns", true)
		if fallback then keySpawnsFolder = fallback end
	end

	local spawnPoints = keySpawnsFolder:GetChildren()
	if #spawnPoints &lt; Config.Objectives.TotalRequired then
		warn("[OBJECTIVE] Not enough key spawn points! Found:", #spawnPoints, " folder:", tostring(keySpawnsFolder))
		return
	end
	print("[OBJECTIVE] Using", #spawnPoints, "key spawn points from", keySpawnsFolder:GetFullName())
	
	-- Shuffle and pick 3 distinct locations
	local availableIndices = {}
	for i = 1, #spawnPoints do
		table.insert(availableIndices, i)
	end
	
	local selectedPoints = {}
	for i = 1, Config.Objectives.TotalRequired do
		local idx = math.random(1, #availableIndices)
		local pointIndex = table.remove(availableIndices, idx)
		table.insert(selectedPoints, spawnPoints[pointIndex])
	end
	
	-- Create key interactables at selected points
	for i, spawnPoint in ipairs(selectedPoints) do
		local keyPart = Instance.new("Part")
		keyPart.Name = "ObjectiveKey_" .. i
		keyPart.Size = Vector3.new(1.4, 0.5, 2.0)
		keyPart.Color = Color3.fromRGB(245, 205, 50)
		keyPart.Material = Enum.Material.Neon -- readable even in dark rooms
		keyPart.CFrame = spawnPoint.CFrame * CFrame.new(0, 0.4, 0)
		keyPart.Anchored = true
		keyPart.CanCollide = false
		keyPart.Parent = interactablesFolder
		
		-- Visual Highlight box
		local highlight = Instance.new("Highlight")
		highlight.FillColor = Color3.fromRGB(255, 220, 80)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.4
		highlight.OutlineTransparency = 0.1
		highlight.Parent = keyPart
		
		local prompt = Instance.new("ProximityPrompt")
		prompt.ObjectText = Config.Objectives.ObjectiveNames[i] or ("Key #" .. i)
		prompt.ActionText = "Pick Up Key"
		prompt.HoldDuration = 0.4
		prompt.MaxActivationDistance = Config.Objectives.InteractionDistance
		prompt.Enabled = true
		-- Show the prompt even if the camera views the key edge-on or the key
		-- sits slightly behind a furniture rim; pickup is still server-validated.
		prompt.RequiresLineOfSight = false
		prompt.Parent = keyPart

		prompt.Triggered:Connect(function(player)
			ObjectiveService.TryCollectObjective(player, keyPart)
		end)

		print(string.format("[OBJECTIVE] Spawned %s at %s parent=%s prompt(Enabled=%s MaxDist=%s Action='%s' Object='%s')",
			keyPart.Name, tostring(keyPart.CFrame.Position), keyPart.Parent.Name,
			tostring(prompt.Enabled), tostring(prompt.MaxActivationDistance),
			prompt.ActionText, prompt.ObjectText))
		
		activeObjectives[keyPart] = {
			Id = i,
			Name = prompt.ObjectText,
			Collected = false,
		}
	end
	
	ObjectiveService.SetupRoundClues(interactablesFolder)

	-- Self-report: one line per key + totals so Play-mode Output proves
	-- exactly what exists in Workspace during the round.
	for _, line in ipairs(ObjectiveService.GetKeyReport()) do
		print(line)
	end
	ObjectiveService.BroadcastProgress()
end

function ObjectiveService.SetupRoundClues(interactablesFolder: Instance)
	-- Clear old clues
	for _, child in ipairs(interactablesFolder:GetChildren()) do
		if child.Name:sub(1, 9) == "ClueNote_" then
			child:Destroy()
		end
	end
	
	local clueSpawnsFolder = workspace:FindFirstChild("ClueSpawns")
	local cluePoints = clueSpawnsFolder and clueSpawnsFolder:GetChildren() or {}
	
	for i, clueDef in ipairs(Config.Clues) do
		if i &lt;= #cluePoints then
			local spawnPoint = cluePoints[i]
			local notePart = Instance.new("Part")
			notePart.Name = "ClueNote_" .. i
			notePart.Size = Vector3.new(1.5, 0.1, 2.0)
			notePart.Color = Color3.fromRGB(235, 225, 200)
			notePart.Material = Enum.Material.SmoothPlastic
			notePart.CFrame = spawnPoint.CFrame * CFrame.new(0, 0.1, 0)
			notePart.Anchored = true
			notePart.CanCollide = false
			notePart.Parent = interactablesFolder
			
			notePart:SetAttribute("ClueTitle", clueDef.Title)
			notePart:SetAttribute("ClueText", clueDef.Text)
			
			local prompt = Instance.new("ProximityPrompt")
			prompt.ObjectText = clueDef.Title
			prompt.ActionText = "Read Note"
			prompt.HoldDuration = 0.2
			prompt.MaxActivationDistance = Config.Objectives.InteractionDistance
			prompt.Enabled = true
			prompt.RequiresLineOfSight = false
			prompt.Parent = notePart
			
			local InteractionService = require(game:GetService("ServerScriptService").Services.InteractionService)
			prompt.Triggered:Connect(function(player)
				InteractionService.HandleReadClue(player, notePart)
			end)
		end
	end
end

function ObjectiveService.TryCollectObjective(player: Player, keyPart: Instance)
	-- Server validation: living, in-round player only
	if not Utility.IsPlayerAlive(player) then
		warn("[OBJECTIVE] Pickup rejected (not alive):", player.Name)
		return false
	end
	local rs = ObjectiveService.RoundService
	if not rs or rs.GetState() ~= Constants.RoundState.ACTIVE then
		warn("[OBJECTIVE] Pickup rejected (round not ACTIVE):", player.Name, rs and rs.GetState() or "no RoundService")
		return false
	end
	if rs.GetPlayerState(player) ~= Constants.PlayerState.PLAYING then
		warn("[OBJECTIVE] Pickup rejected (player state):", player.Name, rs.GetPlayerState(player))
		return false
	end

	local objData = activeObjectives[keyPart]
	if not objData or objData.Collected then
		warn("[OBJECTIVE] Pickup rejected (unknown/already collected):", player.Name, tostring(keyPart))
		return false
	end
	
	objData.Collected = true
	collectedCount = collectedCount + 1
	print("[OBJECTIVE] Key collected:", player.Name, keyPart.Name, "-&gt;", collectedCount .. "/" .. Config.Objectives.TotalRequired)
	
	-- Hide &amp; disable key part
	keyPart.Transparency = 1
	local highlight = keyPart:FindFirstChildOfClass("Highlight")
	if highlight then highlight.Enabled = false end
	local prompt = keyPart:FindFirstChildOfClass("ProximityPrompt")
	if prompt then prompt.Enabled = false end

	-- Pickup audio for every player (positional, auto-cleanup)
	if uiRemote then
		uiRemote:FireAllClients({
			Action = "PlaySoundAt",
			Sound = "ObjectivePickup",
			Target = keyPart,
			Volume = 0.7,
		})
	end
	if analyticsRef then
		analyticsRef.TrackEvent(Constants.AnalyticsEvents.ObjectiveCollected, {
			Player = player.Name,
			Keys = collectedCount,
		})
	end
	
	ObjectiveService.BroadcastProgress()
	
	if collectedCount &gt;= Config.Objectives.TotalRequired then
		exitUnlocked = true
		ObjectiveService.UnlockExit()
	end
	
	return true
end

function ObjectiveService.TryEscape(player: Player)
	if not exitUnlocked then return false, "Exit Locked" end
	if not Utility.IsPlayerAlive(player) then return false, "Not Alive" end
	if ObjectiveService.RoundService then
		ObjectiveService.RoundService.OnPlayerEscaped(player)
	end
	return true
end

function ObjectiveService.IsExitUnlocked(): boolean
	return exitUnlocked
end

function ObjectiveService.GetCollectedCount(): number
	return collectedCount
end

function ObjectiveService.GetActiveKeyCount(): number
	local n = 0
	local interactables = workspace:FindFirstChild("Interactables")
	if interactables then
		for _, child in ipairs(interactables:GetChildren()) do
			if child.Name:sub(1, 13) == "ObjectiveKey_" then
				n += 1
			end
		end
	end
	return n
end

-- Live diagnostic report (run from Studio's Command Bar during Play):
--   require(game.ServerScriptService.Services.ObjectiveService).GetKeyReport()
-- Returns one line per runtime key with position, visibility props, and the
-- full ProximityPrompt configuration, plus exit/unlock status.
function ObjectiveService.GetKeyReport(): {string}
	local lines = {}
	local interactables = workspace:FindFirstChild("Interactables")
	local count = 0
	if interactables then
		for _, child in ipairs(interactables:GetChildren()) do
			if child.Name:sub(1, 13) == "ObjectiveKey_" then
				count += 1
				local prompt = child:FindFirstChildOfClass("ProximityPrompt")
				local promptText
				if prompt then
					promptText = string.format("Enabled=%s MaxDist=%s Action='%s' Object='%s' LOSRequired=%s",
						tostring(prompt.Enabled), tostring(prompt.MaxActivationDistance),
						prompt.ActionText, prompt.ObjectText, tostring(prompt.RequiresLineOfSight))
				else
					promptText = "MISSING"
				end
				local highlight = child:FindFirstChildOfClass("Highlight")
				table.insert(lines, string.format(
					"[KEY REPORT] %s | path=%s | pos=%s | transparency=%s | size=%s | canCollide=%s | parent=%s | highlight=%s | prompt: %s",
					child.Name, child:GetFullName(), tostring(child.Position),
					tostring(child.Transparency), tostring(child.Size),
					tostring(child.CanCollide), child.Parent and child.Parent.Name or "nil",
					tostring(highlight ~= nil), promptText))
			end
		end
	end

	local exitLine = "[KEY REPORT] exit door prompt: "
	local exitModel = workspace:FindFirstChild("Exit")
	local exitDoor = exitModel and exitModel:FindFirstChild("ExitDoor")
	local exitPrompt = exitDoor and exitDoor:FindFirstChildOfClass("ProximityPrompt")
	if exitPrompt then
		exitLine = exitLine .. string.format("Enabled=%s Action='%s' Object='%s'",
			tostring(exitPrompt.Enabled), exitPrompt.ActionText, exitPrompt.ObjectText)
	else
		exitLine = exitLine .. "MISSING"
	end
	table.insert(lines, exitLine)

	table.insert(lines, string.format(
		"[KEY REPORT] keys in world=%d | collected=%d/%d | exitUnlocked=%s",
		count, collectedCount, Config.Objectives.TotalRequired, tostring(exitUnlocked)))
	return lines
end

function ObjectiveService.UnlockExit()
	print("[OBJECTIVE] EXIT UNLOCKED — all", Config.Objectives.TotalRequired, "keys collected.")
	-- Update Exit Door Keypad visual status
	local exitModel = workspace:FindFirstChild("Exit")
	if exitModel then
		local lockLed = exitModel:FindFirstChild("LockLed")
		if lockLed then
			lockLed.Color = Color3.fromRGB(40, 240, 60) -- Green when unlocked
		end
		local exitDoor = exitModel:FindFirstChild("ExitDoor")
		if exitDoor then
			local prompt = exitDoor:FindFirstChildOfClass("ProximityPrompt")
			if prompt then
				prompt.ActionText = "Escape Now!"
				prompt.ObjectText = "Unlocked Front Exit"
			end
		end
	end

	if objectiveRemote then
		objectiveRemote:FireAllClients({
			Action = "ExitUnlocked",
		})
	end

	-- Unlock chime for every player
	if uiRemote then
		uiRemote:FireAllClients({
			Action = "PlaySoundAt",
			Sound = "ObjectivePickup",
			Target = exitModel and exitModel:FindFirstChild("ExitDoor"),
			Volume = 0.9,
			Pitch = 0.75,
		})
	end
end

function ObjectiveService.BroadcastProgress()
	if objectiveRemote then
		objectiveRemote:FireAllClients({
			Action = "UpdateObjectives",
			Collected = collectedCount,
			Total = Config.Objectives.TotalRequired,
			ExitUnlocked = exitUnlocked,
		})
	end
end

function ObjectiveService.Reset()
	activeObjectives = {}
	collectedCount = 0
	exitUnlocked = false

	-- Destroy leftover runtime objects so rounds never inherit old keys/clues
	local interactables = workspace:FindFirstChild("Interactables")
	if interactables then
		for _, child in ipairs(interactables:GetChildren()) do
			if child.Name:sub(1, 13) == "ObjectiveKey_" or child.Name:sub(1, 9) == "ClueNote_" then
				child:Destroy()
			end
		end
	end
	
	-- Reset Exit Door Keypad visual status to red
	local exitModel = workspace:FindFirstChild("Exit")
	if exitModel then
		local lockLed = exitModel:FindFirstChild("LockLed")
		if lockLed then
			lockLed.Color = Color3.fromRGB(240, 30, 30) -- Red when locked
		end
		local exitDoor = exitModel:FindFirstChild("ExitDoor")
		if exitDoor then
			local prompt = exitDoor:FindFirstChildOfClass("ProximityPrompt")
			if prompt then
				prompt.ActionText = "Unlock &amp; Escape (Requires 3 Keys)"
				prompt.ObjectText = "Heavy Front Exit Door"
			end
		end
	end

	ObjectiveService.BroadcastProgress()
end

return ObjectiveService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_9a00fd097a97f173">
        <Properties>
          <string name="Name">MonsterService</string>
          <ProtectedString name="Source">--[[
	MonsterService.luau
	Server-authoritative Sleeping Man AI state machine &amp; pathing engine.
	- AI decisions run on a throttled tick (not every frame).
	- Movement runs every Heartbeat along PathfindingService waypoints,
	  with straight-line fallback when no path is available.
	- The rig is a jointed R6-style model: limbs are animated procedurally
	  via Motor6D C0 offsets (breathing while sleeping, swing while walking),
	  and the monster physically gets up / lies down through pose tweens.
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")

local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)
local Utility = require(ReplicatedStorage.Shared.Utility)

local MonsterService = {}
local monsterState = Constants.MonsterState.SLEEPING
local monsterRig = nil
local homeCFrame = CFrame.new()    -- lying on the bed
local standCFrame = CFrame.new()   -- standing beside the bed
local targetNoisePosition = nil
local targetPlayer = nil
local stateTimer = 0
local aiTimer = 0
local monsterRemote = nil
local noiseServiceRef = nil
local interactionServiceRef = nil
local roundServiceRef = nil
local analyticsRef = nil

-- Pose / animation
local AI_TICK = 0.2            -- seconds between AI decisions
local PATH_MIN_INTERVAL = 0.8  -- seconds between path recomputes
local pose = "Lying"           -- "Lying" | "Standing" | "Transition"
local transition = nil         -- {from, to, t, dur, onDone}
local animTime = 0
local walkPhase = 0
local joints = {}              -- name -&gt; Motor6D
local baseC0 = {}              -- name -&gt; original C0
local headStirX = 0            -- current neck stir angles (radians)
local headStirZ = 0

-- Pathing
local activeWaypoints = nil
local waypointIndex = 2
local pathDirty = false
local lastPathRequest = -999
local pendingToken = 0

local function horizontalDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- ---------------------------------------------------------------------------
-- Joint cache / procedural animation
-- ---------------------------------------------------------------------------
local function cacheJoints()
	joints = {}
	baseC0 = {}
	if not monsterRig then return end
	local torso = monsterRig:FindFirstChild("Torso")
	if not torso then return end

	local names = { "RootJoint", "Neck", "Left Shoulder", "Right Shoulder", "Left Hip", "Right Hip" }
	for _, name in ipairs(names) do
		local j = torso:FindFirstChild(name)
		if j and j:IsA("Motor6D") then
			joints[name] = j
			baseC0[name] = j.C0
		end
	end
end

local function resetJoints()
	for name, j in pairs(joints) do
		j.C0 = baseC0[name]
	end
	headStirX = 0
	headStirZ = 0
end

local function animateSleeping(dt: number)
	animTime += dt
	local breath = math.sin(animTime * 1.3)

	-- Subtle breathing: shoulders rise/fall slightly, head bobs a touch.
	if joints["Left Shoulder"] then
		joints["Left Shoulder"].C0 = baseC0["Left Shoulder"] * CFrame.Angles(breath * math.rad(2.2), 0, 0)
	end
	if joints["Right Shoulder"] then
		joints["Right Shoulder"].C0 = baseC0["Right Shoulder"] * CFrame.Angles(breath * math.rad(2.2), 0, 0)
	end
	if joints["Neck"] then
		joints["Neck"].C0 = baseC0["Neck"] * CFrame.Angles(breath * math.rad(1.2) + headStirX, 0, headStirZ)
	end
end

local function animateMovement(dt: number, isMoving: boolean)
	if isMoving then
		walkPhase += dt * 9.0
		local swing = math.sin(walkPhase)
		local swingOpp = math.sin(walkPhase + math.pi)
		if joints["Left Shoulder"] then
			joints["Left Shoulder"].C0 = baseC0["Left Shoulder"] * CFrame.Angles(swing * math.rad(38), 0, 0)
		end
		if joints["Right Shoulder"] then
			joints["Right Shoulder"].C0 = baseC0["Right Shoulder"] * CFrame.Angles(swingOpp * math.rad(38), 0, 0)
		end
		if joints["Left Hip"] then
			joints["Left Hip"].C0 = baseC0["Left Hip"] * CFrame.Angles(swingOpp * math.rad(45), 0, 0)
		end
		if joints["Right Hip"] then
			joints["Right Hip"].C0 = baseC0["Right Hip"] * CFrame.Angles(swing * math.rad(45), 0, 0)
		end
	else
		-- Settle back to neutral stand
		walkPhase = 0
		for name, j in pairs(joints) do
			local base = baseC0[name]
			j.C0 = j.C0:Lerp(base, 0.15)
			if (j.C0.Position - base.Position).Magnitude &lt; 0.002 then
				j.C0 = base
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- Pose transitions (get up / lie down)
-- ---------------------------------------------------------------------------
local function startTransition(toCF: CFrame, duration: number, donePose: string, onDone: function?)
	if not monsterRig then return end
	resetJoints()
	transition = {
		from = monsterRig:GetPivot(),
		to = toCF,
		t = 0,
		dur = duration,
		donePose = donePose,
		onDone = onDone,
	}
	pose = "Transition"
end

local function advanceTransition(dt: number)
	transition.t += dt
	local alpha = math.clamp(transition.t / transition.dur, 0, 1)
	-- smooth ease in/out
	local eased = alpha * alpha * (3 - 2 * alpha)
	monsterRig:PivotTo(transition.from:Lerp(transition.to, eased))

	if alpha &gt;= 1 then
		pose = transition.donePose
		local cb = transition.onDone
		transition = nil
		if cb then cb() end
	end
end

-- ---------------------------------------------------------------------------
-- Pathfinding (async compute, cached waypoints)
-- ---------------------------------------------------------------------------
local function requestPath(targetPos: Vector3)
	local now = os.clock()
	if now - lastPathRequest &lt; PATH_MIN_INTERVAL then return end
	lastPathRequest = now
	pathDirty = false

	local fromPos = monsterRig:GetPivot().Position
	pendingToken += 1
	local token = pendingToken

	task.spawn(function()
		local ok, err = pcall(function()
			local path = PathfindingService:CreatePath({
				AgentRadius = 2,
				AgentHeight = 5,
				AgentCanJump = false,
				AgentCanClimb = false,
				WaypointSpacing = 4,
			})
			path:ComputeAsync(fromPos, targetPos)
			if token ~= pendingToken then return end
			if path.Status == Enum.PathStatus.Success then
				local wps = path:GetWaypoints()
				if #wps &gt;= 2 then
					activeWaypoints = wps
					waypointIndex = 2
					return
				end
			end
			activeWaypoints = nil
		end)
		if not ok and token == pendingToken then
			activeWaypoints = nil -- straight-line fallback
		end
	end)
end

local function followMovement(dt: number, moveTarget: Vector3, speed: number)
	local goal = moveTarget

	if activeWaypoints and waypointIndex &lt;= #activeWaypoints then
		local wp = activeWaypoints[waypointIndex]
		goal = wp.Position
		local mPos = monsterRig:GetPivot().Position
		if horizontalDistance(mPos, goal) &lt; 3 then
			waypointIndex += 1
			if waypointIndex &lt;= #activeWaypoints then
				goal = activeWaypoints[waypointIndex].Position
			else
				activeWaypoints = nil
				goal = moveTarget
			end
		end
	end

	MonsterService.MoveToward(goal, speed, dt)
end

-- ---------------------------------------------------------------------------
-- Init / state
-- ---------------------------------------------------------------------------
function MonsterService.Init(remotesFolder: Folder, monsterModel: Model, noiseService, interactionService, roundService, analyticsService)
	monsterRemote = remotesFolder:FindFirstChild(Constants.RemoteNames.MonsterEvent)
	monsterRig = monsterModel
	homeCFrame = monsterModel and monsterModel:GetPivot() or CFrame.new()
	noiseServiceRef = noiseService
	interactionServiceRef = interactionService
	roundServiceRef = roundService
	analyticsRef = analyticsService

	-- Standing spot: beside the bed, facing the bedroom door.
	local hp = homeCFrame.Position
	standCFrame = CFrame.lookAt(Vector3.new(hp.X, 2, hp.Z - 7), Vector3.new(hp.X + 18, 2, hp.Z - 5))

	-- The rig is physics-driven by PivotTo only: disable humanoid upright
	-- control so the lying pose is never fought with.
	if monsterModel then
		local hum = monsterModel:FindFirstChildOfClass("Humanoid")
		if hum then
			pcall(function()
				hum.PlatformStand = true
				hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, false)
				hum:ChangeState(Enum.HumanoidStateType.Physics)
				hum.BreakJointsOnDeath = false
				hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				hum.NameDisplayDistance = 0
			end)
		end
	end

	cacheJoints()
	pose = "Lying"

	-- Register self with noise service
	noiseService.MonsterService = MonsterService

	-- Monster Loop: runs every frame (glue/animation), decisions throttled
	RunService.Heartbeat:Connect(function(deltaTime)
		MonsterService.UpdateAI(deltaTime)
	end)

	print("[MONSTER] MonsterService initialized. AI tick:", AI_TICK, "s")
end

function MonsterService.GetState(): string
	return monsterState
end

function MonsterService.SetState(newState: string)
	if monsterState == newState then return end
	monsterState = newState
	stateTimer = 0

	if monsterRemote then
		monsterRemote:FireAllClients({
			Action = "StateChanged",
			State = newState,
			Position = monsterRig and monsterRig:GetPivot().Position or Vector3.new(),
		})
	end

	if analyticsRef then
		if newState == Constants.MonsterState.WAKING then
			analyticsRef.TrackEvent(Constants.AnalyticsEvents.MonsterWoke)
		elseif newState == Constants.MonsterState.CHASING then
			analyticsRef.TrackEvent(Constants.AnalyticsEvents.ChaseStarted)
		end
	end
end

function MonsterService.OnNoiseEmitted(noiseLevel: number, noisePosition: Vector3?)
	if monsterState == Constants.MonsterState.SLEEPING then
		if noiseLevel &gt;= Config.Noise.Thresholds.WakeMin then
			MonsterService.SetState(Constants.MonsterState.WAKING)
			targetNoisePosition = noisePosition
		elseif noiseLevel &gt;= Config.Noise.Thresholds.AlertMax then
			MonsterService.SetState(Constants.MonsterState.DISTURBED)
			targetNoisePosition = noisePosition
		end
	elseif monsterState == Constants.MonsterState.DISTURBED then
		if noiseLevel &gt;= Config.Noise.Thresholds.WakeMin or noiseLevel &gt;= Config.Noise.Thresholds.DangerMax then
			MonsterService.SetState(Constants.MonsterState.WAKING)
			targetNoisePosition = noisePosition or targetNoisePosition
		end
	elseif monsterState == Constants.MonsterState.SEARCHING then
		if noisePosition then
			targetNoisePosition = noisePosition
			pathDirty = true
		end
	elseif monsterState == Constants.MonsterState.CHASING then
		if noisePosition then
			pathDirty = true
		end
	end
end

-- ---------------------------------------------------------------------------
-- Per-frame orchestrator (glue + animation + throttled decisions)
-- ---------------------------------------------------------------------------
function MonsterService.UpdateAI(deltaTime: number)
	if not monsterRig then return end

	-- Pose transitions always run first (get up / lie down)
	if transition then
		advanceTransition(deltaTime)
		return
	end

	if monsterState == Constants.MonsterState.SLEEPING then
		if pose == "Lying" then
			monsterRig:PivotTo(homeCFrame) -- keep the unanchored rig glued to the bed
			animateSleeping(deltaTime)
		end
		return
	end

	stateTimer = stateTimer + deltaTime
	aiTimer = aiTimer + deltaTime

	if monsterState == Constants.MonsterState.DISTURBED then
		-- Still lying: keep breathing while the tick stirs the head.
		animateSleeping(deltaTime)
		if aiTimer &gt;= AI_TICK then
			aiTimer = aiTimer - AI_TICK
			MonsterService.RunStateTick()
		end
		return
	end

	-- WAKING may begin lying down; the tick starts the get-up transition.
	if pose ~= "Standing" then
		if pose == "Lying" then
			animateSleeping(deltaTime)
		end
		if monsterState == Constants.MonsterState.WAKING and aiTimer &gt;= AI_TICK then
			aiTimer = aiTimer - AI_TICK
			MonsterService.RunStateTick()
		end
		return
	end

	local isMoving = (monsterState == Constants.MonsterState.SEARCHING or monsterState == Constants.MonsterState.CHASING)
		and targetNoisePosition ~= nil
	animateMovement(deltaTime, isMoving)

	if aiTimer &gt;= AI_TICK then
		aiTimer = aiTimer - AI_TICK
		MonsterService.RunStateTick()
	end

	-- Continuous movement every frame (smooth, not stepped)
	local moveTarget = nil
	local speed = Config.Monster.WalkSpeed
	if monsterState == Constants.MonsterState.SEARCHING then
		moveTarget = targetNoisePosition
	elseif monsterState == Constants.MonsterState.CHASING then
		moveTarget = MonsterService.GetTargetPosition()
		speed = Config.Monster.ChaseSpeed
	end

	if moveTarget then
		followMovement(deltaTime, moveTarget, speed)
	end
end

function MonsterService.GetTargetPosition(): Vector3?
	if not targetPlayer then return nil end
	local char = targetPlayer.Character
	if not char then return nil end
	local p = char.PrimaryPart or char:GetPivot()
	return p.Position
end

-- ---------------------------------------------------------------------------
-- Throttled AI decisions
-- ---------------------------------------------------------------------------
function MonsterService.RunStateTick()
	local monsterPos = monsterRig:GetPivot().Position

	if monsterState == Constants.MonsterState.DISTURBED then
		-- Stir: turn the head toward the noise source (still lying down)
		if targetNoisePosition and joints["Neck"] then
			local dn = targetNoisePosition - monsterPos
			local targetX = math.clamp(math.rad(dn.Z * 2.5), math.rad(-30), math.rad(30))
			local targetZ = math.clamp(math.rad(-dn.X * 2.5), math.rad(-30), math.rad(30))
			headStirX = headStirX + (targetX - headStirX) * 0.25
			headStirZ = headStirZ + (targetZ - headStirZ) * 0.25
		end

		if stateTimer &gt;= Config.Monster.StateDurations.DisturbedNotice then
			-- Back to sleep if nothing else happened
			headStirX, headStirZ = 0, 0
			MonsterService.SetState(Constants.MonsterState.SLEEPING)
		end

	elseif monsterState == Constants.MonsterState.WAKING then
		-- Get up on the first tick of waking
		if pose == "Lying" then
			startTransition(standCFrame, 1.0, "Standing", function()
				print("[MONSTER] Awake and on his feet.")
			end)
			return
		end

		if stateTimer &gt;= Config.Monster.StateDurations.WakingDelay and pose == "Standing" then
			MonsterService.SetState(Constants.MonsterState.SEARCHING)
			pathDirty = true
		end

	elseif monsterState == Constants.MonsterState.SEARCHING then
		if not targetNoisePosition then
			MonsterService.ReturnHome()
			return
		end

		if pathDirty or activeWaypoints == nil then
			requestPath(targetNoisePosition)
		end

		local dist = horizontalDistance(monsterPos, targetNoisePosition)
		if dist &lt; 4.0 or stateTimer &gt;= Config.Monster.StateDurations.SearchDuration then
			-- Check for visible players before returning to sleep
			local spotted = MonsterService.ScanForPlayers()
			if not spotted then
				MonsterService.ReturnHome()
			end
		end

	elseif monsterState == Constants.MonsterState.CHASING then
		-- Validate target
		if not targetPlayer or not Utility.IsPlayerAlive(targetPlayer) then
			targetPlayer = nil
			MonsterService.SetState(Constants.MonsterState.SEARCHING)
			pathDirty = true
			return
		end

		local isHiding = interactionServiceRef and interactionServiceRef.IsPlayerHiding(targetPlayer)
		local pPos = MonsterService.GetTargetPosition()
		if not pPos then
			targetPlayer = nil
			MonsterService.SetState(Constants.MonsterState.SEARCHING)
			return
		end

		local dist = horizontalDistance(monsterPos, pPos)
		if isHiding and dist &gt; Config.Monster.CatchDistance then
			-- Lost them behind the wardrobe
			targetPlayer = nil
			MonsterService.SetState(Constants.MonsterState.SEARCHING)
			pathDirty = true
			return
		end

		-- Re-path to the moving target regularly
		if pathDirty or (os.clock() - lastPathRequest) &gt; 0.75 then
			requestPath(pPos)
		end

		if dist &lt;= Config.Monster.CatchDistance then
			MonsterService.CatchPlayer(targetPlayer)
		end
	end

	-- Continuous scan for nearby visible players while active
	if monsterState == Constants.MonsterState.SEARCHING or monsterState == Constants.MonsterState.CHASING then
		MonsterService.ScanForPlayers()
	end
end

function MonsterService.ScanForPlayers(): boolean
	if not monsterRig then return false end
	local monsterPos = monsterRig:GetPivot().Position

	for _, player in ipairs(Players:GetPlayers()) do
		if Utility.IsPlayerAlive(player) then
			local isHiding = interactionServiceRef and interactionServiceRef.IsPlayerHiding(player)
			local char = player.Character
			local pPos = (char.PrimaryPart or char:GetPivot()).Position
			local dist = Utility.GetDistance(monsterPos, pPos)

			local effectiveRadius = Config.Monster.DetectionRadius
			if isHiding then
				effectiveRadius = effectiveRadius * Config.Monster.HidingDetectionMultiplier
			end

			if dist &lt;= effectiveRadius then
				-- A hiding player right next to him is discovered (he is
				-- standing at the wardrobe); otherwise the wardrobe blocks LOS.
				if isHiding and dist &lt;= Config.Monster.CatchDistance then
					targetPlayer = player
					MonsterService.SetState(Constants.MonsterState.CHASING)
					return true
				end

				-- Line of sight check (walls block vision)
				local direction = (pPos - monsterPos).Unit
				local ray = Ray.new(monsterPos + Vector3.new(0, 2, 0), direction * dist)
				local ignoreList = { monsterRig, char }
				local hitPart = workspace:FindPartOnRayWithIgnoreList(ray, ignoreList)

				if not hitPart then
					-- Clear line of sight!
					targetPlayer = player
					MonsterService.SetState(Constants.MonsterState.CHASING)
					pathDirty = true
					return true
				end
			end
		end
	end
	return false
end

function MonsterService.MoveToward(targetPos: Vector3, speed: number, deltaTime: number)
	local currentCF = monsterRig:GetPivot()
	local currentPos = currentCF.Position
	local dir = (targetPos - currentPos)
	local flatDir = Vector3.new(dir.X, 0, dir.Z)

	if flatDir.Magnitude &gt; 0.5 then
		local moveStep = flatDir.Unit * speed * deltaTime
		local newPos = currentPos + moveStep
		local lookCF = CFrame.lookAt(newPos, newPos + flatDir.Unit)
		monsterRig:PivotTo(lookCF)
	end
end

function MonsterService.CatchPlayer(player: Player)
	if not player then return end

	-- Trigger Jumpscare on Client (with monster position for camera aim)
	if monsterRemote then
		monsterRemote:FireClient(player, {
			Action = "Jumpscare",
			Position = monsterRig and monsterRig:GetPivot().Position or Vector3.new(),
		})
	end

	-- Clear any stale hiding state for the caught player
	if interactionServiceRef and interactionServiceRef.ClearHidingState then
		interactionServiceRef.ClearHidingState(player)
	end

	-- Notify RoundService of player catch/death
	if roundServiceRef then
		roundServiceRef.OnPlayerCaught(player)
	end

	targetPlayer = nil
	activeWaypoints = nil
	MonsterService.SetState(Constants.MonsterState.SEARCHING)
	pathDirty = true
end

function MonsterService.ReturnHome()
	targetNoisePosition = nil
	targetPlayer = nil
	activeWaypoints = nil

	if monsterRig and pose ~= "Lying" then
		-- Lie back down smoothly; state reports SLEEPING right away.
		MonsterService.SetState(Constants.MonsterState.SLEEPING)
		startTransition(homeCFrame, 0.9, "Lying", function()
			resetJoints()
		end)
	else
		if monsterRig then
			monsterRig:PivotTo(homeCFrame)
		end
		MonsterService.SetState(Constants.MonsterState.SLEEPING)
	end
end

function MonsterService.Reset()
	transition = nil
	activeWaypoints = nil
	targetNoisePosition = nil
	targetPlayer = nil
	stateTimer = 0
	aiTimer = 0
	walkPhase = 0
	monsterState = Constants.MonsterState.SLEEPING
	pose = "Lying"
	pathDirty = false
	resetJoints()
	if monsterRig then
		monsterRig:PivotTo(homeCFrame)
	end
end

return MonsterService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_a5130bf6ac83b01e">
        <Properties>
          <string name="Name">RoundService</string>
          <ProtectedString name="Source">--[[
	RoundService.luau
	Server-authoritative round lifecycle controller for DON'T WAKE HIM.
	Fixed: timer broadcast throttled to 1/sec, race-condition-safe remote init.
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local Constants = require(ReplicatedStorage.Shared.Constants)
local Utility = require(ReplicatedStorage.Shared.Utility)

local RoundService = {}
local roundState = Constants.RoundState.LOBBY
local roundTimer = 0
local lastTimerBroadcast = -999  -- tracks last time we sent UpdateTimer so we throttle to 1/sec
local activePlayers = {}
local roundRemote = nil

local dataServiceRef = nil
local noiseServiceRef = nil
local objectiveServiceRef = nil
local monsterServiceRef = nil
local rewardServiceRef = nil
local analyticsServiceRef = nil
local interactionServiceRef = nil

local houseSpawns = {}
local lobbySpawns = {}

function RoundService.Init(remotesFolder: Folder, houseSpawnsFolder: Instance, lobbySpawnsFolder: Instance, services: table)
	roundRemote = remotesFolder:FindFirstChild(Constants.RemoteNames.RoundEvent)

	if not roundRemote then
		warn("[ROUND] RoundEvent remote not found in Remotes folder!")
	end

	if houseSpawnsFolder then houseSpawns = houseSpawnsFolder:GetChildren() end
	if lobbySpawnsFolder then lobbySpawns = lobbySpawnsFolder:GetChildren() end

	dataServiceRef = services.DataService
	noiseServiceRef = services.NoiseService
	objectiveServiceRef = services.ObjectiveService
	monsterServiceRef = services.MonsterService
	rewardServiceRef = services.RewardService
	analyticsServiceRef = services.AnalyticsService
	interactionServiceRef = services.InteractionService

	-- Player join/leave connections
	Players.PlayerAdded:Connect(RoundService.OnPlayerAdded)
	Players.PlayerRemoving:Connect(RoundService.OnPlayerRemoving)

	-- Catch players already present in game at boot
	for _, player in ipairs(Players:GetPlayers()) do
		RoundService.OnPlayerAdded(player)
	end

	-- Main Round Heartbeat Loop (each tick isolated: one frame error can
	-- never silently stall the state machine)
	RunService.Heartbeat:Connect(function(deltaTime)
		local ok, err = pcall(function()
			RoundService.Update(deltaTime)
		end)
		if not ok then
			warn("[ROUND] Update error:", err)
		end
	end)

	print("[ROUND] RoundService initialized. House spawns:", #houseSpawns, "Lobby spawns:", #lobbySpawns)
end

function RoundService.GetState(): string
	return roundState
end

function RoundService.SetState(newState: string)
	if roundState == newState then return end
	print("[ROUND] State:", roundState, "-&gt;", newState)
	roundState = newState
	roundTimer = 0
	lastTimerBroadcast = -999

	if roundRemote then
		roundRemote:FireAllClients({
			Action = "StateChanged",
			State = newState,
		})
	end
end

function RoundService.OnPlayerAdded(player: Player)
	if roundState == Constants.RoundState.LOBBY or roundState == Constants.RoundState.COUNTDOWN then
		activePlayers[player.UserId] = Constants.PlayerState.LOBBY
		print("[ROUND] Player added to lobby:", player.Name)
	else
		activePlayers[player.UserId] = Constants.PlayerState.SPECTATING
	end
end

function RoundService.OnPlayerRemoving(player: Player)
	activePlayers[player.UserId] = nil
	if roundState == Constants.RoundState.ACTIVE then
		if analyticsServiceRef then
			analyticsServiceRef.TrackEvent(Constants.AnalyticsEvents.PlayerLeftDuringRound, { Player = player.Name })
		end
		RoundService.CheckRoundEndConditions()
	end
end

function RoundService.Update(deltaTime: number)
	roundTimer = roundTimer + deltaTime

	if roundState == Constants.RoundState.LOBBY then
		local playerCount = #Players:GetPlayers()
		if playerCount &gt;= Config.Round.MinPlayers then
			RoundService.SetState(Constants.RoundState.COUNTDOWN)
		end

	elseif roundState == Constants.RoundState.COUNTDOWN then
		local remaining = math.clamp(math.ceil(Config.Round.CountdownDuration - roundTimer), 0, Config.Round.CountdownDuration)
		RoundService.BroadcastTimerThrottled(remaining)

		if remaining &lt;= 0 then
			local okSR, errSR = pcall(function()
				RoundService.StartRound()
			end)
			if not okSR then
				warn("[ROUND] StartRound FAILED:", errSR)
				-- Force the lifecycle forward so the timer never freezes
				RoundService.SetState(Constants.RoundState.ACTIVE)
			end
		end

	elseif roundState == Constants.RoundState.ACTIVE then
		local remaining = math.clamp(math.ceil(Config.Round.RoundDuration - roundTimer), 0, Config.Round.RoundDuration)
		RoundService.BroadcastTimerThrottled(remaining)

		if remaining &lt;= 0 then
			if analyticsServiceRef then
				analyticsServiceRef.TrackEvent(Constants.AnalyticsEvents.RoundTimedOut, {
					Players = #Players:GetPlayers(),
				})
			end
			RoundService.EndRound(false, "Time Expired")
		end

	elseif roundState == Constants.RoundState.RESULTS then
		if roundTimer &gt;= Config.Round.ResultsDuration then
			RoundService.ResetRound()
		end
	end
end

function RoundService.StartRound()
	RoundService.SetState(Constants.RoundState.STARTING)

	-- Resolve folders robustly (exact child first, then recursive fallback)
	local keySpawnsFolder = workspace:FindFirstChild("KeySpawns") or workspace:FindFirstChild("KeySpawns", true)
	local interactablesFolder = workspace:FindFirstChild("Interactables") or workspace:FindFirstChild("Interactables", true)

	if keySpawnsFolder and interactablesFolder then
		local okObj, errObj = pcall(objectiveServiceRef.SetupRoundObjectives, keySpawnsFolder, interactablesFolder)
		if okObj then
			print("[ROUND] Objective setup done. Active keys in world:", objectiveServiceRef.GetActiveKeyCount())
		else
			warn("[ROUND] SetupRoundObjectives FAILED:", errObj)
		end
	else
		warn("[ROUND] KeySpawns or Interactables folder missing in workspace!",
			"KeySpawns=", tostring(keySpawnsFolder), "Interactables=", tostring(interactablesFolder))
	end

	-- Each reset is isolated: a failure in one system must not prevent the
	-- round from reaching ACTIVE (timer, keys, and teleports keep working).
	local okNoise, errNoise = pcall(noiseServiceRef.ResetNoise)
	if not okNoise then warn("[ROUND] ResetNoise FAILED:", errNoise) end
	local okMonster, errMonster = pcall(monsterServiceRef.Reset)
	if not okMonster then warn("[ROUND] MonsterService.Reset FAILED:", errMonster) end
	if interactionServiceRef and interactionServiceRef.ResetHidingStates then
		local okHide, errHide = pcall(interactionServiceRef.ResetHidingStates)
		if not okHide then warn("[ROUND] ResetHidingStates FAILED:", errHide) end
	end

	-- Spawn active players inside house
	local playerList = Players:GetPlayers()
	activePlayers = {}

	for i, player in ipairs(playerList) do
		activePlayers[player.UserId] = Constants.PlayerState.PLAYING

		if player.Character and #houseSpawns &gt; 0 then
			local spawnPoint = houseSpawns[((i - 1) % #houseSpawns) + 1]
			if spawnPoint then
				player.Character:PivotTo(spawnPoint.CFrame * CFrame.new(0, 4, 0))
			end
		end
	end

	print("[ROUND] Round started with", #playerList, "players.")
	for userId, state in pairs(activePlayers) do
		print("[ROUND] Player state:", userId, state)
	end
	if analyticsServiceRef then
		pcall(analyticsServiceRef.TrackEvent, Constants.AnalyticsEvents.RoundStarted, {
			Players = #playerList,
		})
	end
	-- Unconditional: the round must ALWAYS reach ACTIVE (timer starts ticking)
	RoundService.SetState(Constants.RoundState.ACTIVE)
	print("[ROUND] State is now ACTIVE — timer broadcasting, round playable.")
end

function RoundService.OnPlayerEscaped(player: Player)
	if activePlayers[player.UserId] ~= Constants.PlayerState.PLAYING then return end

	activePlayers[player.UserId] = Constants.PlayerState.ESCAPED
	pcall(function() dataServiceRef.IncrementEscapes(player, roundTimer) end)

	if analyticsServiceRef then
		analyticsServiceRef.TrackEvent(Constants.AnalyticsEvents.PlayerEscaped, {
			Player = player.Name,
			Time = roundTimer,
		})
	end

	if player.Character and #lobbySpawns &gt; 0 then
		player.Character:PivotTo(lobbySpawns[1].CFrame * CFrame.new(0, 4, 0))
	end

	RoundService.CheckRoundEndConditions()
end

function RoundService.OnPlayerCaught(player: Player)
	if activePlayers[player.UserId] ~= Constants.PlayerState.PLAYING then return end

	activePlayers[player.UserId] = Constants.PlayerState.DEAD
	pcall(function() dataServiceRef.IncrementDeaths(player) end)

	if interactionServiceRef and interactionServiceRef.ClearHidingState then
		interactionServiceRef.ClearHidingState(player)
	end

	if analyticsServiceRef then
		analyticsServiceRef.TrackEvent(Constants.AnalyticsEvents.PlayerCaught, {
			Player = player.Name,
		})
	end

	if player.Character and #lobbySpawns &gt; 0 then
		player.Character:PivotTo(lobbySpawns[1].CFrame * CFrame.new(0, 4, 0))
	end

	RoundService.CheckRoundEndConditions()
end

function RoundService.CheckRoundEndConditions()
	local playingCount = 0
	local escapedCount = 0

	for _, state in pairs(activePlayers) do
		if state == Constants.PlayerState.PLAYING then
			playingCount += 1
		elseif state == Constants.PlayerState.ESCAPED then
			escapedCount += 1
		end
	end

	if playingCount == 0 then
		if escapedCount &gt; 0 then
			RoundService.EndRound(true, "Escaped!")
		else
			RoundService.EndRound(false, "All Players Caught")
		end
	end
end

function RoundService.EndRound(success: boolean, reason: string)
	if roundState == Constants.RoundState.ENDING or roundState == Constants.RoundState.RESULTS then return end
	RoundService.SetState(Constants.RoundState.ENDING)

	local timeRemaining = math.max(0, Config.Round.RoundDuration - roundTimer)
	local isClean = monsterServiceRef.GetState() == Constants.MonsterState.SLEEPING

	local resultsData = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local state = activePlayers[player.UserId]
		local escaped = (state == Constants.PlayerState.ESCAPED)
		local earnedCoins = 0
		pcall(function()
			local coins, _ = rewardServiceRef.CalculateRewards(player, escaped, timeRemaining, isClean)
			earnedCoins = coins or 0
			dataServiceRef.AddCoins(player, earnedCoins)
		end)
		resultsData[player.UserId] = {
			Escaped = escaped,
			CoinsEarned = earnedCoins,
		}
	end

	if roundRemote then
		roundRemote:FireAllClients({
			Action = "RoundResults",
			Success = success,
			Reason = reason,
			Results = resultsData,
			RoundTime = roundTimer,
			KeysCollected = objectiveServiceRef and objectiveServiceRef.GetCollectedCount and objectiveServiceRef.GetCollectedCount() or 0,
		})
	end

	if analyticsServiceRef then
		analyticsServiceRef.TrackEvent(Constants.AnalyticsEvents.RoundCompleted, {
			Success = success,
			Reason = reason,
			RoundTime = roundTimer,
		})
	end

	RoundService.SetState(Constants.RoundState.RESULTS)
end

function RoundService.ResetRound()
	RoundService.SetState(Constants.RoundState.RESETTING)

	objectiveServiceRef.Reset()
	monsterServiceRef.Reset()
	noiseServiceRef.ResetNoise()
	if interactionServiceRef then
		if interactionServiceRef.ResetDoors then
			interactionServiceRef.ResetDoors()
		end
		if interactionServiceRef.ResetHidingStates then
			interactionServiceRef.ResetHidingStates()
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		activePlayers[player.UserId] = Constants.PlayerState.LOBBY
		if player.Character and #lobbySpawns &gt; 0 then
			player.Character:PivotTo(lobbySpawns[1].CFrame * CFrame.new(0, 4, 0))
		end
	end

	RoundService.SetState(Constants.RoundState.LOBBY)
end

function RoundService.SetPlayerState(player: Player, state: string)
	activePlayers[player.UserId] = state
end

function RoundService.GetPlayerState(player: Player): string
	return activePlayers[player.UserId] or Constants.PlayerState.LOBBY
end

-- Throttled timer broadcast: only fires once per second to avoid network flooding
function RoundService.BroadcastTimerThrottled(seconds: number)
	local now = os.clock()
	if now - lastTimerBroadcast &lt; 0.9 then return end
	lastTimerBroadcast = now

	if roundRemote then
		roundRemote:FireAllClients({
			Action = "UpdateTimer",
			TimeRemaining = seconds,
			FormattedTime = Utility.FormatTime(seconds),
		})
	end
end

return RoundService
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="RBX_ddcd2f3b5a3472a0">
      <Properties>
        <string name="Name">MainServer</string>
        <ProtectedString name="Source">--[[
	MainServer.server.luau
	Master Server entry point for DON'T WAKE HIM.
--]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Players = game:GetService("Players")

local Constants = require(ReplicatedStorage.Shared.Constants)

-- Ensure Remotes Folder exists
local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
if not remotesFolder then
	remotesFolder = Instance.new("Folder")
	remotesFolder.Name = "Remotes"
	remotesFolder.Parent = ReplicatedStorage
end

-- Create missing RemoteEvents if needed
for _, remoteName in pairs(Constants.RemoteNames) do
	if not remotesFolder:FindFirstChild(remoteName) then
		local remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = remotesFolder
	end
end

-- Load Services
local Services = ServerScriptService:WaitForChild("Services")
local DataService = require(Services.DataService)
local AnalyticsService = require(Services.AnalyticsService)
local RewardService = require(Services.RewardService)
local MonetizationService = require(Services.MonetizationService)
local NoiseService = require(Services.NoiseService)
local InteractionService = require(Services.InteractionService)
local ObjectiveService = require(Services.ObjectiveService)
local MonsterService = require(Services.MonsterService)
local RoundService = require(Services.RoundService)

-- Boot marker: proves in Play-mode Output that MainServer reached execution.
print("[SERVER] Boot: module requires OK. Initializing services...")

-- Round lifecycle must survive any single service failing to init:
-- each Init is isolated, failures are loud, RoundService.Init always runs.
local function safeInit(name: string, fn: () -&gt; ())
	local ok, err = pcall(fn)
	if not ok then
		warn("[SERVER] INIT FAILED: " .. name .. " -&gt; " .. tostring(err))
	end
	return ok
end

-- Initialize DataService
safeInit("DataService", function()
	DataService.Init()
end)

-- Initialize Noise Service
safeInit("NoiseService", function()
	NoiseService.Init(remotesFolder)
end)

-- Get Workspace Nodes safely
local house = workspace:WaitForChild("House", 10) or workspace:FindFirstChild("House")
local houseSpawns = house and house:WaitForChild("SpawnPoints", 5) or workspace:FindFirstChild("SpawnPoints", true)
local lobby = workspace:WaitForChild("Lobby", 10) or workspace:FindFirstChild("Lobby")
local lobbySpawns = lobby and lobby:WaitForChild("SpawnPoints", 5) or workspace:FindFirstChild("SpawnPoints", true)
local monsterRig = house and house:WaitForChild("SleepingMan", 5) or workspace:FindFirstChild("SleepingMan", true)

-- Initialize Core Services
safeInit("ObjectiveService", function()
	ObjectiveService.Init(remotesFolder, RoundService, AnalyticsService)
end)
safeInit("MonsterService", function()
	MonsterService.Init(remotesFolder, monsterRig, NoiseService, InteractionService, RoundService, AnalyticsService)
end)
safeInit("InteractionService", function()
	InteractionService.Init(remotesFolder, NoiseService, ObjectiveService, RoundService, DataService)
end)
safeInit("MonetizationService", function()
	MonetizationService.Init(remotesFolder, DataService, AnalyticsService)
end)

-- Initialize Round Lifecycle Controller
safeInit("RoundService", function()
	RoundService.Init(remotesFolder, houseSpawns, lobbySpawns, {
		DataService = DataService,
		AnalyticsService = AnalyticsService,
		RewardService = RewardService,
		MonetizationService = MonetizationService,
		NoiseService = NoiseService,
		InteractionService = InteractionService,
		ObjectiveService = ObjectiveService,
		MonsterService = MonsterService,
	})
end)

-- Noise gating: only accept player noise while a round is ACTIVE
NoiseService.SetRoundService(RoundService)

print("[SERVER] DON'T WAKE HIM master server services initialized cleanly.")
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="RBX_36ebf8582c235966">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="RBX_106ab2b0741b8ed2">
      <Properties>
        <string name="Name">MainHUD</string>
        <bool name="ResetOnSpawn">false</bool>
      </Properties>
      <Item class="Frame" referent="RBX_ab5f2693a75eee22">
        <Properties>
          <string name="Name">NoiseFrame</string>
          <UDim2 name="Position">
            <XS>0.02</XS>
            <XO>0</XO>
            <YS>0.02</YS>
            <YO>0</YO>
          </UDim2>
          <UDim2 name="Size">
            <XS>0</XS>
            <XO>240</XO>
            <YS>0</YS>
            <YO>36</YO>
          </UDim2>
          <Color3 name="BackgroundColor3">
            <R>0.1</R>
            <G>0.1</G>
            <B>0.12</B>
          </Color3>
          <float name="BackgroundTransparency">0.3</float>
        </Properties>
        <Item class="Frame" referent="RBX_0d846b9becd6934d">
          <Properties>
            <string name="Name">NoiseBarFill</string>
            <UDim2 name="Position">
              <XS>0</XS>
              <XO>2</XO>
              <YS>0</YS>
              <YO>2</YO>
            </UDim2>
