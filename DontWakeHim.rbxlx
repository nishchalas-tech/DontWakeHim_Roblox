      <Item class="ModuleScript" referent="RBX_2bea66860ae62a49">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">--[[
	Config.luau
	Centralized configuration for DON'T WAKE HIM.
	All tunable gameplay parameters are declared here.
--]]

local Config = {}

-- Round Lifecycle
Config.Round = {
	MinPlayers = 1,
	MaxPlayers = 3,
	CountdownDuration = 10, -- Seconds before round starts
	RoundDuration = 240, -- 4 minutes
	ResultsDuration = 8, -- Seconds result screen stays visible
	IntermissionDuration = 5, -- Time in lobby before next countdown
}

-- Movement Speeds
Config.Movement = {
	WalkSpeed = 14,
	SprintSpeed = 22,
	WalkFootstepInterval = 0.45, -- Seconds between walk footsteps
	SprintFootstepInterval = 0.28, -- Seconds between sprint footsteps
}

-- Noise System (0 to 100)
Config.Noise = {
	MaxNoise = 100,
	DecayRatePerSecond = 5.0, -- Noise reduction per second when quiet
	DecayDelayAfterNoise = 1.0, -- Delay before decay resumes after action
	
	Thresholds = {
		SafeMax = 39,    -- 0-39 SAFE
		AlertMax = 69,   -- 40-69 ALERT
		DangerMax = 89,  -- 70-89 DANGER
		WakeMin = 90,    -- 90-100 WAKE
	},
	
	Contributions = {
		Walk = 1,        -- Periodic +1 while walking
		Run = 3,         -- Periodic +3 while running
		Sprint = 5,      -- Periodic +5 while sprinting
		OpenDoor = 2,    -- Burst +2 on door toggle
		DropItem = 10,   -- Burst +10 on dropping heavy item
		LoudEvent = 20,  -- Major burst +20 (e.g. tripping object)
	},
}

-- Sleeping Man AI
Config.Monster = {
	WalkSpeed = 10,
	ChaseSpeed = 17,
	DetectionRadius = 38, -- Max distance monster can hear/see
	DirectVisionAngle = 65, -- Degrees field of view angle
	
	StateDurations = {
		DisturbedNotice = 3.0, -- Seconds in DISTURBED before returning to sleep if quiet
		WakingDelay = 2.0,     -- Seconds in WAKING reaction window before SEARCHING
		SearchDuration = 7.0,  -- Seconds searching last noise location before returning to sleep
		ChaseLostTimeout = 4.0, -- Seconds out of line-of-sight before dropping chase to SEARCHING
	},
	
	HidingDetectionMultiplier = 0.1, -- Reduced detection multiplier when player is inside hiding spot (90% reduction)
	CatchDistance = 3.5, -- Touch distance for jumpscare/kill trigger
}

-- Objectives &amp; Exit
Config.Objectives = {
	TotalRequired = 3,
	ObjectiveNames = { "Rusty Brass Key", "Master Bedroom Key", "Front Door Keycard" },
	InteractionDistance = 8.5,
}

-- Clues Pool
Config.Clues = {
	{ Title = "Dusty Note", Text = "I left one of the spare keys near the kitchen sink..." },
	{ Title = "Torn Journal Page", Text = "He locks his bedroom door at night. Check the hallway table." },
	{ Title = "Scribbled Paper", Text = "Look around the living room coffee table for clues." },
	{ Title = "Warning Note", Text = "DON'T MAKE NOISE! He wakes up if the noise meter reaches WAKE level!" },
}

-- Rewards &amp; Progression
Config.Rewards = {
	EscapeCoins = 100,
	TimeBonusCoinsPerSec = 0.5, -- Additional coins per remaining second
	CleanBonusCoins = 50, -- Bonus if monster never reached WAKING/CHASING state
	ParticipationCoins = 15, -- Given to caught/spectating players on round end
}

-- DataStore Defaults
Config.DataDefaults = {
	Coins = 0,
	Escapes = 0,
	Deaths = 0,
	BestTime = nil, -- In seconds (lower is better)
	Cosmetics = {
		Flashlight = "Default",
		MonsterSkin = "Default",
		DeathEffect = "Default",
		Title = "Survivor",
	},
	Settings = {
		MusicVolume = 0.8,
		SFXVolume = 1.0,
		ReducedEffects = false,
	},
}

-- Shop &amp; Cosmetics Catalog
Config.ShopCatalog = {
	Flashlights = {
		{ Id = "Flashlight_Default", Name = "Standard Light", Price = 0, Category = "Flashlight" },
		{ Id = "Flashlight_Crimson", Name = "Crimson Lantern", Price = 150, Category = "Flashlight" },
		{ Id = "Flashlight_UV", Name = "UV Nightlight", Price = 300, Category = "Flashlight" },
	},
	Titles = {
		{ Id = "Title_Survivor", Name = "Survivor", Price = 0, Category = "Title" },
		{ Id = "Title_Ghost", Name = "Silent Ghost", Price = 200, Category = "Title" },
		{ Id = "Title_Fearless", Name = "Fearless", Price = 400, Category = "Title" },
	},
}

-- Security &amp; Anti-Exploit
Config.Security = {
	MaxInteractionDistance = 12.0,
	RateLimitEventsPerSec = 15,
}

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_eb48ef5823a9c448">
        <Properties>
          <string name="Name">Constants</string>
          <ProtectedString name="Source">--[[
	Constants.luau
	Enums, states, and constants for DON'T WAKE HIM.
--]]

local Constants = {}

Constants.RoundState = {
	LOBBY = "LOBBY",
	COUNTDOWN = "COUNTDOWN",
	STARTING = "STARTING",
	ACTIVE = "ACTIVE",
	ENDING = "ENDING",
	RESULTS = "RESULTS",
	RESETTING = "RESETTING",
}

Constants.MonsterState = {
	SLEEPING = "SLEEPING",
	DISTURBED = "DISTURBED",
	WAKING = "WAKING",
	SEARCHING = "SEARCHING",
	CHASING = "CHASING",
}

Constants.PlayerState = {
	LOBBY = "LOBBY",
	PLAYING = "PLAYING",
	HIDING = "HIDING",
	ESCAPED = "ESCAPED",
	DEAD = "DEAD",
	SPECTATING = "SPECTATING",
}

Constants.NoiseLevel = {
	SAFE = "SAFE",
	ALERT = "ALERT",
	DANGER = "DANGER",
	WAKE = "WAKE",
}

Constants.InteractionType = {
	KEY = "KEY",
	DOOR = "DOOR",
	EXIT = "EXIT",
	HIDING_SPOT = "HIDING_SPOT",
	LOUD_OBJECT = "LOUD_OBJECT",
}

-- RemoteEvents and their direction (both sides verified in code):
--   RoundEvent      SERVER -&gt; CLIENT (state, timer, results)
--   ObjectiveEvent  SERVER -&gt; CLIENT (key progress, exit unlocked)
--   NoiseEvent      CLIENT -&gt; SERVER (movement/action noise) ; SERVER -&gt; CLIENT (meter updates)
--   MonsterEvent    SERVER -&gt; CLIENT (state changes, jumpscare)
--   UIEvent         CLIENT -&gt; SERVER (GetStats/GetSettings/SaveSettings) ; SERVER -&gt; CLIENT (clues, sounds, data)
--   ShopEvent       CLIENT -&gt; SERVER (OpenShop/Buy) ; SERVER -&gt; CLIENT (ShopData/PurchaseResult)
Constants.RemoteNames = {
	RoundEvent = "RoundEvent",
	ObjectiveEvent = "ObjectiveEvent",
	NoiseEvent = "NoiseEvent",
	MonsterEvent = "MonsterEvent",
	UIEvent = "UIEvent",
	ShopEvent = "ShopEvent",
}

Constants.AnalyticsEvents = {
	RoundStarted = "RoundStarted",
	RoundCompleted = "RoundCompleted",
	PlayerEscaped = "PlayerEscaped",
	PlayerCaught = "PlayerCaught",
	ObjectiveCollected = "ObjectiveCollected",
	MonsterWoke = "MonsterWoke",
	ChaseStarted = "ChaseStarted",
	RoundTimedOut = "RoundTimedOut",
	ShopOpened = "ShopOpened",
	CosmeticPurchased = "CosmeticPurchased",
	PlayerDied = "PlayerDied",
	PlayerLeftDuringRound = "PlayerLeftDuringRound",
}

return Constants
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_15554a9c34ec44ab">
        <Properties>
          <string name="Name">Utility</string>
          <ProtectedString name="Source">--[[
	Utility.luau
	Helper routines for DON'T WAKE HIM.
--]]

local Utility = {}

function Utility.GetDistance(posA: Vector3, posB: Vector3): number
	return (posA - posB).Magnitude
end

function Utility.IsPlayerAlive(player: Player): boolean
	if not player or not player.Character then
		return false
	end
	local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health &gt; 0
end

function Utility.CreateRateLimiter(maxPerSec: number)
	local requests = {}
	return function(player: Player): boolean
		local now = os.clock()
		local pId = player.UserId
		requests[pId] = requests[pId] or {}
		
		-- Prune old entries
		local valid = {}
		for _, t in ipairs(requests[pId]) do
			if now - t &lt; 1.0 then
				table.insert(valid, t)
			end
		end
		
		if #valid &gt;= maxPerSec then
			return false -- Rate limit exceeded
		end
		
		table.insert(valid, now)
		requests[pId] = valid
		return true
	end
end

function Utility.FormatTime(seconds: number): string
	local mins = math.floor(seconds / 60)
	local secs = math.floor(seconds % 60)
	return string.format("%02d:%02d", mins, secs)
end

return Utility
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="RBX_8d483b6a89813ddc">
      <Properties>
        <string name="Name">Remotes</string>
